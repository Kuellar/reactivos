{
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Bash(git *)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.local)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
